{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "global-shortcut:allow-is-registered",
    "autostart:default",
    "sql:default",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-load",
    "allow-save-credential",
    "allow-has-credential",
    "allow-get-credential",
    "allow-delete-credential",
    "allow-fetch-clickup-tasks",
    "allow-fetch-clickup-list-statuses",
    "allow-update-clickup-task-status",
    "allow-check-clickup",
    "allow-fetch-bitbucket-prs",
    "allow-check-bitbucket",
    "allow-list-bitbucket-repos",
    "allow-fetch-gitlab-prs",
    "allow-check-gitlab",
    "allow-send-claude-message",
    "allow-brief-outlook-inbox",
    "allow-check-claude-cli",
    "allow-compute-claude-usage",
    "allow-read-claude-rate-limits",
    "allow-fetch-ai-news",
    "allow-fetch-meetings",
    "allow-get-outlook-inbox",
    "allow-open-outlook",
    "allow-refresh-outlook",
    "allow-quit-app",
    "allow-get-reminder-settings",
    "allow-set-reminder-settings",
    "allow-clear-notifications",
    "allow-dismiss-notification",
    "allow-get-notification-feed",
    "allow-preview-notification-sound"
  ]
}
